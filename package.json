{
  "name": "sillar-vivo-api",
  "version": "1.0.0",
  "private": true,
  "description": "API MVC para Sillar Vivo, tienda ficticia de artesanía arequipeña",
  "type": "module",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --env-file-if-exists=.env --test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.1.0",
    "zod": "^4.1.0"
  }
}
